{
  "$id": "urn:hushvoting:conformance:identity:v1:schemas:dat-vectors",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Portable credential envelope vectors (contract C-C): deterministic fixed-salt/nonce positive fixtures, wrong-password, wrong-magic, wrong-version, truncation, oversized, ciphertext tamper, and decrypted-JSON structural negatives.",
  "properties": {
    "contractVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "kind": {
      "const": "dat-vectors"
    },
    "maxEnvelopeBytes": {
      "minimum": 1,
      "type": "integer"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "vectors": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "baseEnvelopeRef": {
            "pattern": "^D-[0-9]{3}$",
            "type": "string"
          },
          "envelopeHex": {
            "pattern": "^[0-9a-f]*$",
            "type": "string"
          },
          "errorCode": {
            "minLength": 1,
            "type": "string"
          },
          "expected": {
            "enum": [
              "OK",
              "ERROR"
            ]
          },
          "expectedPayloadJson": {
            "type": "string"
          },
          "id": {
            "pattern": "^D-[0-9]{3}$",
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "DECRYPT",
              "PARSE",
              "OVERSIZED",
              "KEY_CONSISTENCY"
            ]
          },
          "password": {
            "type": "string"
          },
          "payloadJson": {
            "type": "string"
          },
          "producerId": {
            "pattern": "^P-[0-9]{2}$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "operation",
          "expected"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "contractVersion",
    "kind",
    "maxEnvelopeBytes",
    "vectors"
  ],
  "title": ".dat v1 Vectors",
  "type": "object"
}
