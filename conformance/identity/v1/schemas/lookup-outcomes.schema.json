{
  "$id": "urn:hushvoting:conformance:identity:v1:schemas:lookup-outcomes",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic offline identity-lookup evidence: a synthetic registry of controlled test identities and outcome scenarios covering zero, one, and multiple matches, exact-pair deduplication, and compressed/uncompressed distinct candidates.",
  "properties": {
    "contractVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "kind": {
      "const": "lookup-outcomes"
    },
    "registry": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "encryptionAddress": {
            "pattern": "^(02|03|04)[0-9a-f]{64,128}$",
            "type": "string"
          },
          "id": {
            "pattern": "^R-[0-9]{3}$",
            "type": "string"
          },
          "profileAlias": {
            "minLength": 1,
            "type": "string"
          },
          "signingAddress": {
            "pattern": "^(02|03|04)[0-9a-f]{64,128}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "signingAddress",
          "encryptionAddress",
          "profileAlias"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "scenarios": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "encryptionAddress": {
                  "pattern": "^(02|03|04)[0-9a-f]{64,128}$",
                  "type": "string"
                },
                "producerId": {
                  "pattern": "^P-[0-9]{2}$",
                  "type": "string"
                },
                "signingAddress": {
                  "pattern": "^(02|03|04)[0-9a-f]{64,128}$",
                  "type": "string"
                }
              },
              "required": [
                "producerId",
                "signingAddress",
                "encryptionAddress"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "expected": {
            "additionalProperties": false,
            "properties": {
              "ambiguous": {
                "type": "boolean"
              },
              "deduplicated": {
                "type": "boolean"
              },
              "matchCount": {
                "minimum": 0,
                "type": "integer"
              },
              "producers": {
                "items": {
                  "pattern": "^P-[0-9]{2}$",
                  "type": "string"
                },
                "type": "array"
              },
              "registryIds": {
                "items": {
                  "pattern": "^R-[0-9]{3}$",
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "matchCount",
              "ambiguous"
            ],
            "type": "object"
          },
          "id": {
            "pattern": "^L-[0-9]{3}$",
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "candidates",
          "expected"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schemaVersion",
    "contractVersion",
    "kind",
    "registry",
    "scenarios"
  ],
  "title": "Controlled Identity Lookup Outcomes",
  "type": "object"
}
