{
  "$id": "urn:hushvoting:conformance:identity:v1:schemas:producer",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Version-controlled inventory record for one historical Hush credential producer: immutable ID, evidence classification, frozen precedence, evidence references, and contract summary.",
  "properties": {
    "classification": {
      "enum": [
        "APPROVED",
        "UNSUPPORTED",
        "UNVERIFIED",
        "EXCLUDED",
        "NOT_A_PRODUCER"
      ]
    },
    "contract": {
      "minLength": 1,
      "type": "string"
    },
    "contractVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "evidence": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "mnemonicSupport": {
      "enum": [
        "24",
        "12_AND_24",
        "NONE",
        "UNKNOWN"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "precedence": {
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "producerId": {
      "pattern": "^P-[0-9]{2}$",
      "type": "string"
    },
    "publicKeyEncoding": {
      "enum": [
        "COMPRESSED",
        "UNCOMPRESSED",
        "NONE",
        "UNKNOWN"
      ]
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "signatureBehavior": {
      "minLength": 1,
      "type": "string"
    },
    "supportedOperations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "contractVersion",
    "producerId",
    "name",
    "classification",
    "precedence",
    "evidence",
    "contract",
    "supportedOperations"
  ],
  "title": "Producer Record",
  "type": "object"
}
