{
  "$id": "urn:hushvoting:conformance:identity:v1:schemas:negative-vectors",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Negative and unsupported-input vectors: invalid mnemonics, unsupported producers/versions, unsupported passphrases, and other deterministic rejections that prevent accidental compatibility expansion.",
  "properties": {
    "contractVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "kind": {
      "const": "negative-vectors"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "vectors": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "errorCode": {
            "minLength": 1,
            "type": "string"
          },
          "expected": {
            "const": "ERROR"
          },
          "id": {
            "pattern": "^N-[0-9]{3}$",
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "MNEMONIC_VALIDATE",
              "MNEMONIC_DERIVE",
              "PRODUCER_SELECT",
              "VERSION_SELECT"
            ]
          },
          "passphrase": {
            "type": "string"
          },
          "producerId": {
            "pattern": "^P-[0-9]{2}$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "operation",
          "expected"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "contractVersion",
    "kind",
    "vectors"
  ],
  "title": "Negative Vectors",
  "type": "object"
}
