{
  "$id": "urn:hushvoting:conformance:identity:v1:schemas:report",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Secret-safe JSON summary produced by TypeScript and .NET conformance runners. Failure records carry contract/schema version, producer ID, fixture ID, operation, field path, stable error code, and expected/actual digests only. Never emits raw mnemonics, passwords, private keys, decrypted .dat content, or ciphertext.",
  "properties": {
    "contractVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "actualDigest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "contractVersion": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "type": "string"
          },
          "errorCode": {
            "minLength": 1,
            "type": "string"
          },
          "expectedDigest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "fieldPath": {
            "minLength": 1,
            "type": "string"
          },
          "fixtureId": {
            "minLength": 1,
            "type": "string"
          },
          "operation": {
            "minLength": 1,
            "type": "string"
          },
          "producerId": {
            "pattern": "^P-[0-9]{2}$",
            "type": "string"
          },
          "schemaVersion": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "type": "string"
          }
        },
        "required": [
          "contractVersion",
          "schemaVersion",
          "producerId",
          "fixtureId",
          "operation",
          "fieldPath",
          "errorCode",
          "expectedDigest",
          "actualDigest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR"
      ]
    },
    "runtime": {
      "enum": [
        "typescript",
        "dotnet"
      ]
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "failed": {
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total",
        "passed",
        "failed"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "contractVersion",
    "runtime",
    "result",
    "summary",
    "records"
  ],
  "title": "Cross-Runtime Conformance Report",
  "type": "object"
}
