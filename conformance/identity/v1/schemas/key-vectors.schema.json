{
  "$id": "urn:hushvoting:conformance:identity:v1:schemas:key-vectors",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "secp256k1 public-key encoding, decoding, and private-scalar validity vectors: compressed/uncompressed equivalence, malformed encodings, and zero/out-of-range scalars.",
  "properties": {
    "contractVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "kind": {
      "const": "key-vectors"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "vectors": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "encoding": {
            "enum": [
              "COMPRESSED",
              "UNCOMPRESSED"
            ]
          },
          "errorCode": {
            "minLength": 1,
            "type": "string"
          },
          "expected": {
            "enum": [
              "OK",
              "ERROR"
            ]
          },
          "expectedPointXHex": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "expectedPointYHex": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "expectedPublicKeyHex": {
            "pattern": "^(02|03|04)[0-9a-f]{64,128}$",
            "type": "string"
          },
          "id": {
            "pattern": "^K-[0-9]{3}$",
            "type": "string"
          },
          "inputHex": {
            "pattern": "^[0-9a-f]+$",
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "PUBLIC_KEY_DERIVE",
              "DECODE",
              "SCALAR_VALIDATE",
              "POINT_EQUIVALENCE"
            ]
          },
          "privateScalarHex": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "producerId": {
            "pattern": "^P-[0-9]{2}$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "operation",
          "expected"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "contractVersion",
    "kind",
    "vectors"
  ],
  "title": "Key Encoding Vectors",
  "type": "object"
}
