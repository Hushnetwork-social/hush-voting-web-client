{
  "$id": "urn:hushvoting:conformance:identity:v1:schemas:canonical-byte-vectors",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact UTF-8 bytes of the canonical signed-transaction representation (TS producer JSON.stringify order, 3-digit-millisecond ISO timestamp, computed PayloadSize) plus deterministic tamper variants proving property names, ordering, value formatting, UTF-8 encoding, and payload-size behavior.",
  "properties": {
    "contractVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "kind": {
      "const": "canonical-byte-vectors"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "vectors": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "expected": {
            "enum": [
              "MATCH",
              "DIFFERENT"
            ]
          },
          "id": {
            "pattern": "^CB-[0-9]{3}$",
            "type": "string"
          },
          "json": {
            "type": "string"
          },
          "mutation": {
            "minLength": 1,
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "SERIALIZE",
              "TAMPER"
            ]
          },
          "payloadSize": {
            "minimum": 0,
            "type": "integer"
          },
          "utf8Hex": {
            "pattern": "^[0-9a-f]+$",
            "type": "string"
          },
          "utf8Length": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "operation",
          "json",
          "utf8Hex",
          "utf8Length",
          "expected"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "contractVersion",
    "kind",
    "vectors"
  ],
  "title": "Canonical Transaction Byte Vectors",
  "type": "object"
}
