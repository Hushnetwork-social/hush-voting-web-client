{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hush.network/vault/v1/schemas/manifest.schema.json",
  "title": "HushVault Corpus Manifest v1",
  "description": "Deterministic sorted SHA-256 manifest for the canonical vault corpus. Mirrors conformance/identity/v1 conventions: UTF-8 no BOM, LF endings, stable sorted order, exact byte lengths and digests. No wall-clock inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "corpusVersion", "files"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "corpusVersion": { "const": "1.0.0" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[a-z0-9/._-]+$" },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
