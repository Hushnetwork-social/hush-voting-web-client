{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hushnetwork-social/hush-voting-web-client/conformance/android-vault/v1/schemas/android-evidence.schema.json",
  "title": "Android Qualification Evidence",
  "description": "Sanitized qualification report (FEAT-006). Only broad API/security level, build digest, scenario outcomes, and contract versions. Records containing serials, Android IDs, attestation IDs, identity, exact timestamps, model fingerprints, aliases, URIs, ciphertext, or secrets are rejected by validators in both runtimes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceClass",
    "buildDigest",
    "apiLevel",
    "securityLevel",
    "capabilityClass",
    "scenarioResults",
    "contractVersions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceClass": {
      "enum": [
        "emulator",
        "physicalTee",
        "physicalOldestApi",
        "physicalCurrentApi",
        "physicalStrongBox",
        "package",
        "accessibility",
        "security"
      ]
    },
    "buildDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "apiLevel": { "type": "integer", "minimum": 28, "maximum": 99 },
    "securityLevel": { "enum": ["strongBox", "tee", "softwareOrUnknown"] },
    "capabilityClass": { "enum": ["qualified", "capabilityCompatible", "blocked"] },
    "scenarioResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario", "passed"],
        "properties": {
          "scenario": { "type": "string", "minLength": 1, "maxLength": 128 },
          "passed": { "type": "boolean" }
        }
      }
    },
    "contractVersions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "value": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    }
  }
}
