{
  "name": "hush-voting-web-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "clean": "rimraf .next .next-web .next-tauri .next-static out coverage",
    "clean:native": "rimraf src-tauri/target",
    "dev": "next dev --port 3201",
    "dev:tauri": "cross-env TAURI_DEV=true next dev --port 3202",
    "build": "npm run build:web",
    "build:web": "cross-env STANDALONE_BUILD=true next build",
    "build:static": "cross-env STATIC_EXPORT=true next build",
    "brand:sync": "node scripts/brand/sync-from-website.mjs",
    "desktop:identity:install": "node scripts/dev/install-linux-desktop-entry.mjs",
    "start": "next start --port 3201",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "pretauri:dev": "npm run desktop:identity:install",
    "tauri:dev": "tauri dev",
    "tauri:build:linux": "tauri build --bundles deb,appimage",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build:debug": "tauri android build --debug --apk --aab",
    "identity:conformance": "vitest run --silent=true src/lib/identity-compatibility/conformance",
    "vault:manifest": "node conformance/vault/v1/scripts/generate-manifest.mjs",
    "vault:integrity": "node conformance/vault/v1/scripts/generate-manifest.mjs --check && node conformance/vault/v1/scripts/validate.mjs",
    "vault:integrity:tests": "node --test conformance/vault/v1/tests/manifest-integrity.test.mjs conformance/vault/v1/tests/production-exclusion.test.mjs conformance/vault/v1/tests/handoff.test.mjs",
    "vault:conformance": "vitest run --silent=true src/lib/vault-core/conformance",
    "vault:conformance:isolated": "vitest run --silent=true src/lib/vault-core/conformance/isolated-validator.test.ts",
    "vault:production-exclusion": "node scripts/vault/production-exclusion.mjs",
    "vault:ci": "node scripts/vault/ci-vault.mjs",
    "vault:ci:replay": "node scripts/vault/replay-prior-versions.mjs",
    "vault:ci:selftest": "node scripts/vault/ci-self-test.mjs",
    "vault:test:adversarial": "vitest run --silent=true src/lib/vault-core/adversarial",
    "vault:security-gates": "node scripts/vault/security-gates.mjs",
    "vault:archive": "node scripts/vault/archive.mjs",
    "vault:archive:check": "node scripts/vault/archive.mjs --check",
    "test:browser": "playwright test",
    "test:browser:auth": "playwright test browser/",
    "auth:audit": "node scripts/auth/artifact-audit.mjs",
    "auth:audit:selftest": "node scripts/auth/artifact-audit.mjs --selftest",
    "browser-vault:production-exclusion": "node scripts/browser-vault/production-exclusion.mjs",
    "browser-vault:audit": "node scripts/browser-vault/artifact-audit.mjs",
    "browser-vault:dependency-audit": "npm audit --audit-level=high",
    "browser-vault:browser-blocks": "playwright test browser/vault-storage.spec.ts browser/vault-coordination.spec.ts browser/vault-qualification.spec.ts browser/vault-performance.spec.ts",
    "browser-vault:deployment-policy": "node scripts/browser-vault/deployment-policy.mjs",
    "browser-vault:handoff": "node scripts/browser-vault/handoff.mjs",
    "browser-vault:ci": "node scripts/browser-vault/ci-browser-vault.mjs",
    "browser-vault:ci:selftest": "node scripts/browser-vault/ci-browser-vault.mjs --selftest",
    "browser-vault:matrix": "node scripts/browser-vault/matrix.mjs",
    "browser-vault:security-qualification": "node scripts/browser-vault/security-qualification.mjs",
    "browser-vault:qualification-report": "node scripts/browser-vault/qualification-report.mjs",
    "ubuntu-vault:ci": "node scripts/ubuntu-vault/ci-ubuntu-vault.mjs",
    "ubuntu-vault:ci:selftest": "node scripts/ubuntu-vault/ci-ubuntu-vault.mjs --selftest",
    "ubuntu-vault:qualification": "node scripts/ubuntu-vault/qualification-harness.mjs",
    "android-vault:test": "node --test scripts/android-vault/android-vault.test.mjs",
    "android-vault:ci": "node scripts/android-vault/ci-android-vault.mjs",
    "android-vault:ci:selftest": "node scripts/android-vault/ci-android-vault.mjs --selftest",
    "android-vault:policy": "node scripts/android-vault/policy-check.mjs --manifest src-tauri/gen/android/app/src/main/AndroidManifest.xml",
    "android-vault:customize": "node scripts/android-vault/customize-project.mjs --project src-tauri/gen/android",
    "android-vault:adversarial": "node scripts/android-vault/adversarial-matrix.mjs",
    "android-vault:secret-scan": "node scripts/android-vault/secret-scan.mjs",
    "android-vault:qualification": "node scripts/android-vault/qualification-harness.mjs --digest development",
    "identity-create:coverage": "node scripts/identity-create/validate-coverage-manifest.mjs ../hush-voting-memory-bank/Features/04_COMPLETED/FEAT-007-blockchain-identity-creation-flow/acceptance-coverage-manifest.json",
    "test:identity-create:bdd": "playwright test --config playwright.identity-create.config.ts",
    "identity-create:secret-scan": "node scripts/identity-create/secret-scan.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@noble/secp256k1": "^3.1.0",
    "@tauri-apps/api": "^2.11.1",
    "bip39": "^3.1.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.3.0",
    "playwright-bdd": "9.2.0",
    "postcss": "^8.5.15",
    "rimraf": "^6.1.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch": "10.2.6",
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
