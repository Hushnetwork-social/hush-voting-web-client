{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HushVoting",
  "version": "0.1.0",
  "identifier": "com.hushvoting.client",
  "build": {
    "frontendDist": "../.next-static",
    "devUrl": "http://localhost:3202",
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build:static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HushVoting",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https://api.hushnetwork.social; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "linux/hushvoting.desktop.hbs"
      }
    }
  }
}
